# ---------------------------------------------------------------------------
# Business Expense Tracker - environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Data source: "mock" runs the app entirely on local seeded mock data with no
# Gmail connection. "gmail" enables real Google OAuth + Gmail API sync.
DATA_MODE="mock"

# SQLite database file used by Prisma.
DATABASE_URL="file:./prisma/dev.db"

# --- Google OAuth / Gmail API (required when DATA_MODE="gmail") ------------
# Create these in Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# Requested scope must be read-only: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# --- Security ----------------------------------------------------------------
# 32-byte (base64) key used to encrypt OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Secret used to sign the app's own session cookie. Generate the same way.
SESSION_SECRET=""

# --- Optional: third-party AI-assisted extraction ---------------------------
# Disabled by default. Only enable if you have explicitly reviewed and
# approved sending unmatched email/receipt text to an external AI provider.
# This app will NOT call any external AI service unless this is set.
AI_ASSISTED_EXTRACTION_ENABLED="false"
AI_PROVIDER_API_KEY=""
